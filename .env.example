# Environment Mode
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeos?schema=public"

# Redis Configuration (BullMQ & Event Bus)
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration
# Local Ollama ($0 Development)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LOCAL_MODEL="llama3.2:3b"

# Optional Cloud Providers (Leave blank for local-only development)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
